# ente-admin settings for docker-compose.yml. Copy to .env and edit. Every variable is
# described in docs/CONFIG.md. Secrets go in files under ./secrets (mounted at /secrets),
# never in this file: use the *_FILE variants.

# ---- login ----
# basic: users from secrets/users (`name:hash`, made with `ente-admin hash-password`)
# header: behind a login proxy (Authelia, oauth2-proxy...), see docs/SECURITY.md
ENTE_ADMIN_AUTH=basic
ENTE_ADMIN_USERS_FILE=/secrets/users
# ENTE_ADMIN_TRUSTED_PROXIES=172.16.0.0/12
# ENTE_ADMIN_ADMIN_GROUPS=admins

# ---- try it with synthetic data (remove for a real server) ----
ENTE_ADMIN_DEMO=true

# ---- your Ente server ----
# One or more servers, comma separated; each one's variables start with its name.
# ENTE_ADMIN_INSTANCES=photos

# museum source: an admin account's token (docs/SETUP.md, "Admin token")
# ENTE_ADMIN_PHOTOS_SOURCE=museum
# ENTE_ADMIN_PHOTOS_URL=http://museum:8080
# ENTE_ADMIN_PHOTOS_TOKEN_FILE=/secrets/token

# postgres source: more detail (Locker, links, storage, notifications), docs/POSTGRES.md
# ENTE_ADMIN_PHOTOS_SOURCE=postgres
# ENTE_ADMIN_PHOTOS_DSN=host=postgres port=5432 dbname=ente_db user=ente_dashboard
# ENTE_ADMIN_PHOTOS_PASSWORD_FILE=/secrets/db-password
# ENTE_ADMIN_PHOTOS_EMAIL_KEY_FILE=/secrets/email-key       # museum's key.encryption, to show emails
# ENTE_ADMIN_PHOTOS_API_URL=http://museum:8080              # for the admin portal
# ENTE_ADMIN_PHOTOS_URL=https://api.photos.example.com      # public museum URL, for health checks

# Web apps to check (Locker, share links...), docs/LOCKER.md
# ENTE_ADMIN_PHOTOS_APPS=photos=https://photos.example.com,locker=https://locker.example.com,share=https://share.example.com
# museum.yaml, mounted read-only, for config diffs (see docker-compose.yml)
# ENTE_ADMIN_PHOTOS_MUSEUM_CONFIG_FILE=/museum.yaml

# ---- what to show ----
ENTE_ADMIN_REVEAL_EMAILS=false
# ENTE_ADMIN_MODULES=overview,ticker,accounts,devices,activity,locker,notifications

# ---- admin portal: manage accounts after an Ente admin sign-in (docs/ADMIN.md) ----
ENTE_ADMIN_ENABLE_ACTIONS=false
# ENTE_ADMIN_MAIL_FROM=admin@example.com
# Optional write role: revoke share links, sign out devices (docs/POSTGRES.md)
# ENTE_ADMIN_PHOTOS_WRITE_DSN=host=postgres port=5432 dbname=ente_db user=ente_dashboard_write
# ENTE_ADMIN_PHOTOS_WRITE_PASSWORD_FILE=/secrets/db-write-password

# ---- email notifications (docs/NOTIFICATIONS.md) ----
# off | shadow (record only) | send
ENTE_ADMIN_NOTIFY=off
# ENTE_ADMIN_SMTP_HOST=smtp.example.com
# ENTE_ADMIN_SMTP_PORT=587
# ENTE_ADMIN_SMTP_SECURITY=starttls
# ENTE_ADMIN_SMTP_USERNAME=noreply@example.com
# ENTE_ADMIN_SMTP_PASSWORD_FILE=/secrets/smtp-password
# ENTE_ADMIN_SMTP_FROM=noreply@example.com
# ENTE_ADMIN_SMTP_FROM_NAME=Photos
# ENTE_ADMIN_TEMPLATES_DIR=/templates

# ---- published port on localhost (docker-compose.yml) ----
# ENTE_ADMIN_PUBLISH_PORT=8001
